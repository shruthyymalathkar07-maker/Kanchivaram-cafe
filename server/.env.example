# PostgreSQL Database Connection URL (Hosted Production or Local)
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=production

# Frontend Application URL (for CORS)
CORS_ORIGIN="*"

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 2Factor SMS OTP Gateway (https://2factor.in)
TWO_FACTOR_API_KEY=
TWO_FACTOR_OTP_TEMPLATE=

# OTP Provider (use 'mock' for local development/offline testing; strictly prohibited in production)
OTP_PROVIDER=mock

# Google OAuth 2.0 Web Application Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://kanchivaram-cafe.onrender.com/api/auth/google/callback

# OpenAI API Configuration for KVCM AI Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini



