{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist-server"
  },
  "include": ["server/src/**/*", "server/prisma/**/*"],
  "exclude": ["node_modules", "dist"]
}
